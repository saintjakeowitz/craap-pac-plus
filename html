<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Flight of the InfoLit — Single-File</title>
<meta name="description" content="A whimsical, accessible info-literacy mini-game suite for libraries." />
<meta name="theme-color" content="#940731" />
<!-- No external fonts, no analytics, no trackers. System font stack only. -->

<style>
  :root{
    /* Brand tokens */
    --crimson:#940731;
    --pink-a:#db4a6a;
    --pink-b:#d54264;
    --pink-c:#da4969;
    --white:#ffffff;
    --ink:#111111;

    /* A11y / layout */
    --bg:#fff;
    --fg:#111;
    --muted:#333;
    --focus:#111; /* high-contrast outline; color not sole cue */
    --radius:16px;
    --space-1:4px; --space-2:8px; --space-3:12px; --space-4:16px; --space-5:24px; --space-6:32px;

    /* Sizing */
    --maxw:960px;
  }

  @media (prefers-color-scheme: dark){
    :root{ --bg:#111; --fg:#fff; --muted:#cfcfcf; --focus:#fff; }
    body { background:#111; color:#fff; }
  }

  html,body{height:100%}
  body{
    margin:0;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
    background: var(--bg);
    color: var(--fg);
    line-height:1.45;
  }

  .wrap{max-width:var(--maxw); margin:auto; padding: var(--space-6) var(--space-4)}
  .sr-only{position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden}
  .btn{
    appearance:none; border:2px solid var(--crimson); background:var(--crimson); color:#fff;
    padding:10px 14px; border-radius:999px; cursor:pointer; font-weight:700;
  }
  .btn.secondary{ background:transparent; color:var(--crimson);}
  .btn.ghost{ border-color:var(--pink-a); color:var(--pink-a); background:transparent; }
  .btn:focus-visible{ outline:3px dashed var(--focus); outline-offset:2px }
  .btn[disabled]{ opacity:.6; cursor:not-allowed }
  .btn.ghost.selected{ outline:3px dashed var(--focus); outline-offset:2px; }

  .hud{
    display:flex; flex-wrap:wrap; gap:var(--space-3); align-items:center; justify-content:space-between;
    padding:var(--space-3) var(--space-4); border:1px solid var(--pink-b); border-radius:var(--radius);
    background: linear-gradient(180deg, rgba(148,7,49,.12), rgba(219,74,106,.07));
  }
  .hud .stat{ display:flex; gap:8px; align-items:center; font-weight:700 }
  .chip{
    display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px;
    border:2px solid var(--pink-a); background:rgba(219,74,106,.08); margin:4px 6px; cursor:pointer; user-select:none;
  }
  .chip[aria-pressed="true"]{ background:var(--pink-a); color:#fff }
  .chip:focus-visible{ outline:3px dashed var(--focus) }

  .card{ border:1px solid var(--pink-b); border-radius:var(--radius); padding:var(--space-5); background:rgba(255,255,255,.6) }
  @media (prefers-color-scheme: dark){ .card{ background:rgba(0,0,0,.35)}}

  .grid{ display:grid; gap:var(--space-4)}
  .grid.cols-2{ grid-template-columns:1fr; }
  @media(min-width:720px){ .grid.cols-2{ grid-template-columns:1fr 1fr } }

  .deco{
    /* Art-deco geometric frame using layered gradients */
    border-radius:var(--radius); padding:var(--space-5); position:relative; overflow:hidden;
    background:
      conic-gradient(from 90deg at 10% 10%, transparent 0 25%, rgba(148,7,49,.12) 0 50%, transparent 0 100%),
      conic-gradient(from 270deg at 90% 90%, transparent 0 25%, rgba(219,74,106,.12) 0 50%, transparent 0 100%);
    border:2px solid var(--crimson);
  }

  .title{
    display:flex; align-items:center; justify-content:center; gap:12px; text-align:center;
    font-weight:900; letter-spacing:.04em; text-transform:uppercase; font-size: clamp(20px, 4.5vw, 36px);
    color:var(--crimson);
  }

  /* Airplane SVG badge */
  .plane{ width:32px; height:32px; }
  .plane svg{ display:block }

  .choices, .dropzones{ display:flex; flex-wrap:wrap; gap:10px; margin-top:8px }
  .dropzone{
    flex:1 1 220px; min-height:86px; border:2px dashed var(--pink-c); border-radius:12px; padding:10px;
  }
  .dropzone h4{ margin:.25rem 0 .5rem 0 }
  .pill{
    border:2px solid var(--pink-c); border-radius:999px; padding:6px 10px; cursor:grab; display:inline-block;
    background:rgba(218,73,105,.08)
  }
  .pill:focus-visible{ outline:3px dashed var(--focus) }
  .pill[data-selected="true"]{ box-shadow:0 0 0 3px var(--focus) inset; }

  .kbd{ font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; background:#0002; border:1px solid #0003; padding:2px 6px; border-radius:6px }

  .muted{ color:var(--muted) }

  .dialog-backdrop{
    position:fixed; inset:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center;
  }
  .dialog{
    max-width:680px; width:95%; background:var(--bg); color:var(--fg);
    border-radius:16px; border:2px solid var(--pink-b); padding:20px;
  }

  .progress{
    width:100%; height:10px; border-radius:999px; background:#0001; overflow:hidden; border:1px solid #0003
  }
  .progress > div{ height:100%; background:linear-gradient(90deg, var(--crimson), var(--pink-a)); width:0% }

  .notice{ padding:12px 14px; border-left:6px solid var(--pink-a); background:rgba(219,74,106,.08); border-radius:8px }

  .footer-actions{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; justify-content:flex-end }

  /* Focus visible outlines for interactive elements globally */
  a:focus-visible, button:focus-visible, [tabindex]:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible{
    outline:3px dashed var(--focus); outline-offset:2px;
  }

  /* Reduced motion: disable transitions/animations */
  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; scroll-behavior:auto !important; }
  }
</style>
</head>
<body>
<div class="wrap" id="app" aria-live="polite">
  <header class="deco" role="banner" aria-label="Game header">
    <h1 class="title">
      <span class="plane" aria-hidden="true">
        <!-- Inline art-deco airplane (brand colors) -->
        <svg viewBox="0 0 64 64" role="img" aria-label="Crimson airplane">
          <path fill="#940731" d="M3 36l20-6 6-20c.6-2.1 3.6-2.1 4.2 0l6 20 20 6c2.1.6 2.1 3.6 0 4.2l-20 6-6 20c-.6 2.1-3.6 2.1-4.2 0l-6-20-20-6c-2.1-.6-2.1-3.6 0-4.2z"/>
          <circle cx="32" cy="32" r="4" fill="#db4a6a"/>
        </svg>
      </span>
      Flight of the InfoLit
      <span class="plane" aria-hidden="true">
        <svg viewBox="0 0 64 64"><path fill="#da4969" d="M3 36l20-6 6-20c.6-2.1 3.6-2.1 4.2 0l6 20 20 6c2.1.6 2.1 3.6 0 4.2l-20 6-6 20c-.6 2.1-3.6 2.1-4.2 0l-6-20-20-6c-2.1-.6-2.1-3.6 0-4.2z"/></svg>
      </span>
    </h1>
    <p class="muted" id="tagline">Welcome aboard, researcher. Please keep your curiosity in the upright and locked position. 🍬✈️</p>
  </header>

  <div id="screen"></div>
</div>

<!-- Accessible modal (Teach Me / Hints / Admin) -->
<div class="dialog-backdrop" id="modal-backdrop" role="none">
  <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-desc">
    <h2 id="modal-title" class="title" style="font-size:22px">Dialog</h2>
    <div id="modal-desc"></div>
    <div class="footer-actions" style="margin-top:16px">
      <button class="btn" id="modal-close" aria-label="Close dialog">Close</button>
    </div>
  </div>
</div>

